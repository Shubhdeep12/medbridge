{
  "name": "medbridge",
  "version": "1.0.0",
  "description": "Clinical handover platform with MCP and A2A standards",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:demo": "DEMO_MODE=true node dist/server.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "lint": "eslint src/**/*.ts",
    "test": "vitest"
  },
  "keywords": [
    "healthcare",
    "mcp",
    "a2a",
    "fhir",
    "clinical-handover",
    "ai-agents"
  ],
  "author": "MedBridge Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
