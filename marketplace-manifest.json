{
  "name": "medbridge",
  "displayName": "MedBridge Clinical Handover",
  "version": "1.0.0",
  "description": "AI-powered clinical handover platform for nursing shift transitions with MCP and A2A standards",
  "category": "Clinical Workflow",
  "tags": [
    "handover",
    "nursing",
    "shift-transition",
    "clinical-decision-support",
    "risk-assessment",
    "mcp",
    "a2a",
    "fhir"
  ],
  "author": {
    "name": "MedBridge Team",
    "email": "contact@medbridge.health"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/medbridge/healthcare-handover"
  },
  "homepage": "https://medbridge.health",
  "documentation": "https://docs.medbridge.health",
  "support": {
    "email": "support@medbridge.health",
    "url": "https://support.medbridge.health"
  },
  "pricing": {
    "model": "free",
    "trial": false
  },
  "targetAudience": [
    "nurses",
    "physicians",
    "care-coordinators",
    "hospitals",
    "health-systems"
  ],
  "useCases": [
    {
      "title": "Nursing Shift Handover",
      "description": "Streamline end-of-shift handovers with AI-generated summaries and risk detection"
    },
    {
      "title": "Critical Patient Monitoring",
      "description": "Continuous risk assessment with automatic escalation for deteriorating patients"
    },
    {
      "title": "Documentation Gap Detection",
      "description": "Identify missing information in care plans and nursing notes"
    }
  ],
  "technicalDetails": {
    "protocols": ["MCP", "A2A"],
    "standards": ["FHIR R4", "SMART-on-FHIR", "SHARP Context"],
    "runtime": "Node.js 20",
    "deployment": ["Cloudflare Workers", "Railway", "VPS"],
    "authentication": ["OAuth2", "API Key"]
  },
  "mcpConfiguration": {
    "serverEndpoint": "https://medbridge-mcp.chhabrashubhdeep.workers.dev/mcp",
    "tools": [
      {
        "name": "get_patient_vitals",
        "description": "Retrieves vital signs with trend analysis",
        "category": "Data Access"
      },
      {
        "name": "get_recent_nurse_notes",
        "description": "Retrieves and summarizes nursing documentation",
        "category": "Data Access"
      },
      {
        "name": "handover_summary",
        "description": "Generates comprehensive handover summary",
        "category": "AI Generation"
      },
      {
        "name": "escalate_to_attending",
        "description": "Creates critical alerts to physicians",
        "category": "Action"
      }
    ]
  },
  "a2aConfiguration": {
    "agentCard": "src/a2a/agent-card.json",
    "capabilities": [
      "prepare_handover",
      "detect_risks",
      "escalate_critical",
      "receive_handover"
    ],
    "skills": [
      "clinical-handover",
      "risk-assessment",
      "vital-signs-analysis"
    ]
  },
  "fhirConfiguration": {
    "version": "R4",
    "resources": [
      "Patient",
      "Observation",
      "DocumentReference",
      "CommunicationRequest",
      "Task",
      "Encounter"
    ],
    "operations": ["read", "search", "create"],
    "requiredScopes": [
      "patient/Patient.read",
      "patient/Observation.read",
      "patient/DocumentReference.read"
    ],
    "optionalScopes": [
      "patient/CommunicationRequest.write",
      "patient/Task.write"
    ]
  },
  "security": {
    "phiHandling": "session-state-only",
    "encryption": "TLS 1.3",
    "auditLogging": true,
    "hipaaCompliant": true,
    "gdprCompliant": true
  },
  "screenshots": [
    {
      "path": "docs/screenshots/handover-summary.png",
      "description": "AI-generated handover summary"
    },
    {
      "path": "docs/screenshots/risk-assessment.png",
      "description": "Risk assessment dashboard"
    }
  ],
  "demoVideo": {
    "url": "https://youtu.be/demo-video-id",
    "thumbnail": "docs/demo-thumbnail.jpg"
  },
  "installation": {
    "type": "cloudflare-workers",
    "command": "wrangler deploy",
    "endpoint": "https://medbridge-mcp.chhabrashubhdeep.workers.dev/mcp"
  },
  "requirements": {
    "memory": "512MB",
    "cpu": "1 vCPU",
    "storage": "1GB",
    "network": "Outbound HTTPS required"
  }
}
